{# vim: set filetype=lua: #}
{% extends "template.lua.j2" %}
{% block animation %}
		default = "normal",
{% endblock %}
{% block behaviors %}

	on_spawn = function(self)
		self.shown = false
		self:on_end(function(object)
			object.shown = false
			object.animation = "normal"
			object.done()
		end)
	end,

	on_slam = function(self, done)
		self.done = done
		self.shown = true
		self.animation = "slam"
	end,{% endblock %}
